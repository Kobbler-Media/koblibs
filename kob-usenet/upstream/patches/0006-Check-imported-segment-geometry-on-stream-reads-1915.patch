+#[tokio::test]
+async fn another_files_first_part_fails_over_before_any_byte_streams() {
+    let data = vec![0xA5; 2 * ARTICLE_SIZE];
+    let posted = post("f", "file.bin", &data, ARTICLE_SIZE);
+    let mut other = post(
+        "o",
+        "other.bin",
+        &vec![0x5A; 3 * ARTICLE_SIZE],
+        ARTICLE_SIZE,
+    )
+    .remove(0);
+    other.message_id.clone_from(&posted[0].message_id);
+    let wrong = LoopbackServer::start([other]).await.unwrap();
+    let right = LoopbackServer::start(posted.clone()).await.unwrap();
+    let downloads = Downloads::new(16);
+    let only_wrong = Client::new([provider(wrong.addr().port(), 0, None, &downloads)]);
+    let both = Client::new([
+        provider(wrong.addr().port(), 0, None, &downloads),
+        provider(right.addr().port(), 1, None, &downloads),
+    ]);
+    let id = &posted[0].message_id;
+    let expected = BodyExpectation {
+        offset: Some(0),
+        decoded_len: Some(ARTICLE_SIZE as u64),
+        file_size: Some(data.len() as u64),
+        ..BodyExpectation::NONE
+    };
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    let progress = Progress {
+        tx,
+        wanted: Arc::new(AtomicBool::new(true)),
+    };
+
+    let result = only_wrong
+        .body_expecting(id, Workload::Stream, None, Some(&progress), expected)
+        .await;
+    assert!(matches!(result, Err(Error::Yenc(_))), "{:?}", result.err());
+    assert!(
+        rx.try_recv().is_err(),
+        "nothing of another file is streamed"
+    );
+    assert!(matches!(
+        only_wrong.hedge(id, None, expected).await,
+        Err(Error::Yenc(_))
+    ));
+
+    for body in [
+        both.body_expecting(id, Workload::Stream, None, Some(&progress), expected)
+            .await,
+        both.hedge(id, None, expected).await,
+    ] {
+        assert_eq!(body.unwrap().data, data[..ARTICLE_SIZE]);
+    }
+    assert_eq!(downloads.available_permits(), 16);
+}
