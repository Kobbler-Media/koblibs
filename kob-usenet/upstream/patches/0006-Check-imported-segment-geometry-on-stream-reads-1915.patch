 impl BodyExpectation {
+    /// Nothing known: every body passes.
+    pub const NONE: Self = Self {
+        part: None,
+        total: None,
+        file_size: None,
+        offset: None,
+        decoded_len: None,
+    };
+
+    /// Only the expected `=ypart` offset, when known.
+    #[must_use]
+    pub const fn at(offset: Option<u64>) -> Self {
+        Self {
+            offset,
+            ..Self::NONE
