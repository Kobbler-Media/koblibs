 crates/nntp/src/connection.rs | 18 +++++++
 crates/nntp/src/downloads.rs  | 91 +++++++++++++++++++++++++----------
 crates/nntp/src/pool.rs       | 43 +++++++++++++----
 crates/nntp/src/stats.rs      | 27 ++++++++++-
 crates/queue/src/import.rs    | 15 ++++--
 crates/vfs/src/reader.rs      |  7 +++
 7 files changed, 172 insertions(+), 43 deletions(-)

