From 89c2c30c9713ad64b41c6e79d759cad0a2253e90 Mon Sep 17 00:00:00 2001
From: kob <kob@invalid>
Date: Mon, 23 Nov 2026 14:57:55 +1100
Subject: [PATCH] Test backbones under a geometry mismatch

No test set a backbone. A part 1 whose post counts its parts differently from
the listing skips the rest of its backbone, still asks another backbone on the
level, and asks the next level only on another backbone: from one provider it
cannot be told apart from another file's part 1 under the id (#1915), which a
provider elsewhere may hold right.
---
 crates/nntp/src/client.rs | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/crates/nntp/src/client.rs b/crates/nntp/src/client.rs
index 386bc9e9..0b8097ea 100644
--- a/crates/nntp/src/client.rs
+++ b/crates/nntp/src/client.rs
@@ -1220,6 +1220,45 @@ mod tests {
         }
     }
 
+    #[tokio::test]
+    async fn a_geometry_mismatch_skips_its_backbone_but_asks_the_rest() {
+        let corpus = Corpus::generate(1025, 1, 1024);
+        let id = corpus.articles[0].message_id.clone();
+        let mut servers = Vec::new();
+        for _ in 0..5 {
+            servers.push(LoopbackServer::start(corpus.articles.clone()).await.unwrap());
+        }
+        let downloads = Downloads::new(8);
+        let backbones = [("alpha", 0), ("alpha", 0), ("gamma", 0), ("alpha", 99), ("beta", 99)];
+        let providers = backbones
+            .iter()
+            .zip(&servers)
+            .map(|(&(backbone, priority), server)| Provider {
+                backbone: Some(backbone.into()),
+                priority,
+                ..provider(server, &downloads)
+            });
+        let client = Client::new(providers);
+        // Another file's part 1 under the id (#1915) looks the same, and a provider on
+        // another backbone may hold the right one.
+        let listed_total_differs = crate::BodyExpectation {
+            part: Some(1),
+            total: Some(3),
+            ..crate::BodyExpectation::at(Some(0))
+        };
+        for workload in [Workload::Stream, Workload::Queue] {
+            let result = client
+                .body_expecting(&id, workload, None, None, listed_total_differs)
+                .await;
+            assert!(matches!(result, Err(Error::Yenc(_))), "{:?}", result.err());
+        }
+        let bodies: Vec<_> = servers.iter().map(LoopbackServer::body_commands).collect();
+        assert_eq!(bodies[0] + bodies[1], 2, "one alpha copy per request: {bodies:?}");
+        assert_eq!(bodies[2], 2, "the other backbone on the level: {bodies:?}");
+        assert_eq!(bodies[3], 0, "the next level on the same backbone: {bodies:?}");
+        assert_eq!(bodies[4], 2, "the next level on another backbone: {bodies:?}");
+    }
+
     #[tokio::test]
     async fn a_stream_read_gives_up_without_a_download_slot() {
         let corpus = Corpus::generate(1025, 1, 1024);
