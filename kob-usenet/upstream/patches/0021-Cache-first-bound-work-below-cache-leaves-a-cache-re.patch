+/// Requests of one ranked workload in [`Pool::fetch`]; the bound on work below them
+/// lingers [`STREAM_LINGER`] after the last.
+#[derive(Default)]
+struct Presence {
+    requests: usize,
+    until: Option<Instant>,
+}
+
+impl Presence {
+    fn lingering(&self, now: Instant) -> Option<Instant> {
+        self.until.filter(|&until| now < until)
+    }
+
+    fn active(&self, now: Instant) -> bool {
+        self.requests > 0 || self.lingering(now).is_some()
+    }
+
+    const fn leave(&mut self, until: Instant) {
+        self.requests -= 1;
+        self.until = Some(until);
+    }
+}
 
-impl Streaming {
-    fn start(state: &Arc<Mutex<State>>) -> Self {
-        state.lock().unwrap_or_else(PoisonError::into_inner).streams += 1;
-        Self(Arc::clone(state))
+/// Counts one playback (or, with `.1`, cache) request in its [`Presence`].
+struct Present(Arc<Mutex<State>>, bool);
+
+impl Present {
+    fn start(state: &Arc<Mutex<State>>, cache: bool) -> Self {
+        state
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .presence(cache)
+            .requests += 1;
+        Self(Arc::clone(state), cache)
     }
 }
 
-impl Drop for Streaming {
+impl Drop for Present {
     fn drop(&mut self) {
-        let mut state = self.0.lock().unwrap_or_else(PoisonError::into_inner);
-        state.streams -= 1;
-        state.stream_until = Some(Instant::now() + STREAM_LINGER);
+        let until = Instant::now() + STREAM_LINGER;
+        self.0
+            .lock()
+            .unwrap_or_else(PoisonError::into_inner)
+            .presence(self.1)
+            .leave(until);
     }
 }
 
