+#[tokio::test]
+async fn a_provider_is_not_asked_for_articles_past_its_retention() {
+    const DAY: u64 = 24 * 60 * 60;
+    let corpus = Corpus::generate(1025, 1, ARTICLE_SIZE);
+    let id = &corpus.articles[0].message_id;
+    let short = LoopbackServer::start(corpus.articles.clone())
+        .await
+        .unwrap();
+    let long = LoopbackServer::start(corpus.articles.clone())
+        .await
+        .unwrap();
+    let downloads = Downloads::new(16);
+    let recent = || {
+        let p = provider(short.addr().port(), 0, None, &downloads);
+        Provider {
+            pool: p.pool.with_retention(Duration::from_secs(30 * DAY)),
+            ..p
+        }
+    };
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    let posted = |days: u64| Some(i64::try_from(now - days * DAY).unwrap());
+    let at = |days| BodyExpectation {
+        posted: posted(days),
+        ..BodyExpectation::NONE
+    };
+    let both = Client::new([recent(), provider(long.addr().port(), 1, None, &downloads)]);
+    let only = Client::new([recent()]);
+    let lane = infinidysk_nntp::Lane::default();
+
+    let body = both
+        .body_expecting(id, Workload::Stream, None, None, at(40))
+        .await
+        .unwrap();
+    assert_eq!(body.data, corpus.data);
+    both.stat_in_lane(id, lane, Workload::Queue, None, posted(40))
+        .await
+        .unwrap();
+    assert_eq!(short.body_commands(), 0, "past retention");
+    assert!(matches!(
+        only.body_expecting(id, Workload::Stream, None, None, at(40))
+            .await,
+        Err(Error::NotFound)
+    ));
+    assert!(matches!(
+        only.stat_in_lane(id, lane, Workload::Queue, None, posted(40))
+            .await,
+        Err(Error::NotFound)
+    ));
+    assert_eq!(short.body_commands(), 0);
+
+    for expected in [at(10), BodyExpectation::NONE] {
+        let body = only
+            .body_expecting(id, Workload::Stream, None, None, expected)
+            .await
+            .unwrap();
+        assert_eq!(body.data, corpus.data);
+    }
+    assert_eq!(short.body_commands(), 2, "within retention, or undated");
+}
