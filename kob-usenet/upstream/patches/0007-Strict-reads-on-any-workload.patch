+#[tokio::test]
+async fn strict_reads_keep_their_workload_and_fail_on_a_gap() {
+    let corpus = Corpus::generate(1025, 12, ARTICLE_SIZE);
+    let mut served = corpus.articles.clone();
+    served.remove(MISSING);
+    let server = LoopbackServer::start(served).await.unwrap();
+    let gaps = Arc::new(Gaps::default());
+    gaps.refresh([MISSING + 2].into(), false);
+    for workload in [Workload::Stream, Workload::Queue] {
+        let (client, layout) = setup(&corpus, &server);
+        let mut reader = SegmentReader::new(Arc::clone(&client), layout, 8)
+            .with_workload(workload)
+            .with_gaps(Arc::clone(&gaps))
+            .strict(true);
+        let mut head = vec![0; MISSING * ARTICLE_SIZE];
+        reader.read_exact(&mut head).await.unwrap();
+        assert!(head == corpus.data[..head.len()], "{workload:?}");
+        assert!(
+            reader.read(&mut [0; 8]).await.is_err(),
+            "{workload:?}: a strict read fails instead of filling"
+        );
+        reader
+            .seek(SeekFrom::Start(((MISSING + 2) * ARTICLE_SIZE) as u64))
+            .await
+            .unwrap();
+        let mut known = vec![0; ARTICLE_SIZE];
+        reader.read_exact(&mut known).await.unwrap();
+        assert!(
+            known == corpus.data[(MISSING + 2) * ARTICLE_SIZE..][..ARTICLE_SIZE],
+            "{workload:?}: a known hole is still asked for"
+        );
+        let attempts = |w: Workload| -> u64 {
+            client.stats()[0].workloads[w as usize]
+                .attempts
+                .iter()
+                .sum()
+        };
+        assert!(attempts(workload) > 0, "{workload:?}");
+        for other in [Workload::Stream, Workload::Queue, Workload::Health] {
+            if other != workload {
+                assert_eq!(attempts(other), 0, "{workload:?} asked as {other:?}");
+            }
+        }
+    }
+}
