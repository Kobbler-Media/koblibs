+    /// A BODY belonging to one independently scheduled operation. Requests from the
+    /// same lane retain normal pipelining and the global provider/permit limits.
+    pub async fn body_in_lane(
+        &self,
+        message_id: &str,
+        lane: Lane,
+        workload: Workload,
+        probe: Option<&Probe>,
+        begin: Option<u64>,
+    ) -> Result<Body, Error> {
+        self.body_tagged(
+            message_id,
+            Tag {
+                lane: Some(lane),
+                workload,
+                probe: probe.cloned(),
+                begin,
+                ..Tag::UNTRACKED
+            },
+        )
+        .await
+    }
+    /// A STAT in the same connection lane as that operation's BODY requests.
+    pub async fn stat_in_lane(
+        &self,
+        message_id: &str,
+        lane: Lane,
+        workload: Workload,
+        probe: Option<&Probe>,
+    ) -> Result<(), Error> {
+        self.request(
+            Command::Stat,
+            message_id,
+            Tag {
+                lane: Some(lane),
+                workload,
+                probe: probe.cloned(),
+                ..Tag::UNTRACKED
+            },
+        )
+        .await
+        .map(drop)
+    }
