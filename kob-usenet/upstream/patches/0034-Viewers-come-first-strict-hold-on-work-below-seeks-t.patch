+
+/// Connections kept for seeks beside a cache-ahead on a pool of `limit`.
+const fn seek_connections(limit: usize) -> usize {
+    if limit < STREAM_HEADROOM_MIN_CONNECTIONS {
+        return 0;
+    }
+    let quarter = limit / 4;
+    if quarter < SEEK_CONNECTIONS {
+        quarter
+    } else {
+        SEEK_CONNECTIONS
+    }
