+    /// Called just before the request is written to a provider: `false` when it was
+    /// withdrawn, and must not be sent.
+    pub fn send(&self) -> bool {
+        match self
+            .sending
+            .compare_exchange(PENDING, SENT, Ordering::AcqRel, Ordering::Acquire)
+        {
+            Ok(_) | Err(SENT) => true,
+            Err(_) => false,
+        }
+    }
+
+    /// Withdraws a request no provider has been sent yet; `false` once one has.
+    pub fn withdraw(&self) -> bool {
+        matches!(
+            self.sending
+                .compare_exchange(PENDING, WITHDRAWN, Ordering::AcqRel, Ordering::Acquire),
+            Ok(_) | Err(WITHDRAWN)
+        )
+    }
+
+    #[must_use]
+    pub fn withdrawn(&self) -> bool {
+        self.sending.load(Ordering::Acquire) == WITHDRAWN
+    }
+
     /// This fetch started the shared fetch `flight`.
     pub fn lead(&self, flight: u64) {
         self.flight.store(flight, Ordering::Relaxed);
