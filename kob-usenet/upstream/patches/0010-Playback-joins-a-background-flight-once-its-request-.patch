+    #[test]
+    fn playback_joins_a_background_flight_only_once_its_request_is_sent() {
+        let client = Arc::new(Client::new([]));
+        let cache = Arc::new(Cache::new(true, 1 << 20));
+        let probe = Probe {
+            trace: None,
+            wait: None,
+            watch: None,
+            segment: 0,
+            hedge: false,
+            size: 0,
+            reader: 0,
+        };
+        let flight = |workload| {
+            cache.flight(
+                &client,
+                "wire@test",
+                workload,
+                BodyExpectation::NONE,
+                Some(&probe),
+                None,
+            )
+        };
+        let leader = || {
+            cache.inflight.lock().unwrap().flights["wire@test"]
+                .leader
+                .clone()
+                .expect("a traced flight has a wait")
+        };
+        let (warm, _) = flight(Workload::Warm);
+        let queued = leader();
+        let (replacement, joined) = flight(Workload::Stream);
+        assert!(!joined, "a queued background request is replaced");
+        assert!(!queued.send(), "and may no longer be sent");
+        drop((warm, replacement));
+
+        let (warm, _) = flight(Workload::Warm);
+        assert!(leader().send());
+        let (_shared, joined) = flight(Workload::Stream);
+        assert!(joined, "a sent background request is joined");
+        assert!(leader().send(), "a retry may still be sent");
+        drop(warm);
+    }
