+        ];
+        for meta in metas {
+            let bytes = encode_meta(&meta).unwrap();
+            assert_eq!(Blob::parse(&bytes).unwrap().version, 5);
+            assert_eq!(decode_meta(&bytes).unwrap(), meta);
+        }
