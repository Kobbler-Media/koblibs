From 0cb9fdd3de2e485b92db8be7de44e2765d7645e4 Mon Sep 17 00:00:00 2001
From: kob <kob@invalid>
Date: Tue, 24 Nov 2026 14:23:02 +1100
Subject: [PATCH] Cache readers are admitted fairly, so a new one does not wait
 behind another's backlog of download slots

---
 crates/nntp/src/downloads.rs             | 77 +++++++++++++++++++++---
 crates/nntp/src/pool_contention_tests.rs | 62 +++++++++++++++++++
 2 files changed, 129 insertions(+), 10 deletions(-)

diff --git a/crates/nntp/src/downloads.rs b/crates/nntp/src/downloads.rs
index c07db3e9..d3959f91 100644
--- a/crates/nntp/src/downloads.rs
+++ b/crates/nntp/src/downloads.rs
@@ -19,6 +19,8 @@ pub struct Downloads {
 }
 
 const BORROW_DIVISOR: usize = 4;
+/// Imports share rank 0 with cache readers, and take their turn as one reader among them.
+const IMPORT_READER: u64 = u64::MAX;
 
 /// Slots wanted, the reader asking (`0`: none of its own), and where to send the permit.
 type Waiter = (usize, u64, oneshot::Sender<Permit>);
@@ -78,10 +80,9 @@ impl Lanes {
         self.owed += weight - paid;
     }
 
-    /// The playback waiter to admit next: the oldest of the reader holding fewest slots.
-    fn next_urgent(&self) -> Option<usize> {
-        self.urgent
-            .iter()
+    /// The waiter in `lane` to admit next: the oldest of the reader holding fewest slots.
+    fn next_in(&self, lane: &VecDeque<Waiter>) -> Option<usize> {
+        lane.iter()
             .enumerate()
             .filter(|(_, (_, _, tx))| !tx.is_closed())
             .min_by_key(|&(i, &(_, reader, _))| {
@@ -201,7 +202,11 @@ impl Downloads {
         weight: usize,
         reader: u64,
     ) -> Option<Permit> {
-        let reader = if workload.rank().is_none() { reader } else { 0 };
+        let reader = match workload {
+            Workload::Stream | Workload::Cache => reader,
+            Workload::Import => IMPORT_READER,
+            _ => 0,
+        };
         let rx = {
             let mut lanes = self.lock();
             let weight = weight.clamp(1, lanes.total.max(1));
@@ -239,12 +244,13 @@ impl Downloads {
                     lane.pop_front();
                 }
             }
-            let urgent = lanes.next_urgent();
+            let urgent = lanes.next_in(&lanes.urgent);
             let rank = lanes.background.iter().position(|lane| !lane.is_empty());
-            let (at, wanted) = match (urgent, rank) {
-                (Some(at), _) => (at, lanes.urgent[at].0),
-                (None, Some(rank)) => (0, lanes.background[rank][0].0),
-                (None, None) => return,
+            let queued = rank.and_then(|rank| lanes.next_in(&lanes.background[rank]));
+            let (at, wanted) = match (urgent, rank, queued) {
+                (Some(at), _, _) => (at, lanes.urgent[at].0),
+                (None, Some(rank), Some(at)) => (at, lanes.background[rank][at].0),
+                _ => return,
             };
             if !lanes.fits(urgent.is_some(), wanted) {
                 return;
@@ -296,6 +302,57 @@ mod tests {
         assert_eq!(downloads.available_permits(), 1);
     }
 
+    #[tokio::test]
+    async fn a_new_cache_reader_is_admitted_ahead_of_another_readers_backlog() {
+        let downloads = Downloads::new(2);
+        let first = downloads.acquire_for(Workload::Cache, 1, 1).await;
+        let second = downloads.acquire_for(Workload::Cache, 1, 1).await;
+        let order = Arc::new(Mutex::new(Vec::new()));
+        let mut waiters = Vec::new();
+        for reader in [1, 1, 1, 2] {
+            let (downloads, order) = (Arc::clone(&downloads), Arc::clone(&order));
+            waiters.push(tokio::spawn(async move {
+                let permit = downloads.acquire_for(Workload::Cache, 1, reader).await;
+                order.lock().unwrap().push(reader);
+                drop(permit);
+            }));
+            tokio::task::yield_now().await;
+        }
+        tokio::task::yield_now().await;
+        drop(first);
+        drop(second);
+        for waiter in waiters {
+            waiter.await.unwrap();
+        }
+        let order = order.lock().unwrap().clone();
+        assert_eq!(order[0], 2, "{order:?}");
+    }
+
+    #[tokio::test]
+    async fn an_import_keeps_its_turn_beside_cache_readers() {
+        let downloads = Downloads::new(1);
+        let held = downloads.acquire_for(Workload::Cache, 1, 1).await;
+        let order = Arc::new(Mutex::new(Vec::new()));
+        let mut waiters = Vec::new();
+        for (workload, reader) in [
+            (Workload::Import, 0),
+            (Workload::Cache, 1),
+        ] {
+            let (downloads, order) = (Arc::clone(&downloads), Arc::clone(&order));
+            waiters.push(tokio::spawn(async move {
+                let permit = downloads.acquire_for(workload, 1, reader).await;
+                order.lock().unwrap().push(workload);
+                drop(permit);
+            }));
+            tokio::task::yield_now().await;
+        }
+        drop(held);
+        for waiter in waiters {
+            waiter.await.unwrap();
+        }
+        assert_eq!(*order.lock().unwrap(), [Workload::Import, Workload::Cache]);
+    }
+
     #[tokio::test]
     async fn background_waiters_are_served_by_rank() {
         let downloads = Downloads::new(1);
diff --git a/crates/nntp/src/pool_contention_tests.rs b/crates/nntp/src/pool_contention_tests.rs
index 85fab1ea..4f79d244 100644
--- a/crates/nntp/src/pool_contention_tests.rs
+++ b/crates/nntp/src/pool_contention_tests.rs
@@ -279,3 +279,65 @@ async fn a_waiter_wakes_when_a_throttled_pool_may_grow_again() {
     );
     drop(first);
 }
+
+#[tokio::test]
+async fn a_new_cache_reader_gets_bytes_promptly_beside_a_large_cache_ahead() {
+    let corpus = Corpus::generate(94, 41, ARTICLE);
+    let ids: Vec<String> = corpus
+        .articles
+        .iter()
+        .map(|a| a.message_id.clone())
+        .collect();
+    let impairment = infinidysk_testkit::Impairment {
+        response_delay: Duration::from_millis(120),
+        ..Default::default()
+    };
+    let server = LoopbackServer::start_impaired(corpus.articles, impairment)
+        .await
+        .unwrap();
+    let endpoint = Endpoint::new(
+        "127.0.0.1",
+        server.addr().port(),
+        TlsMode::Plain,
+        None,
+        Duration::from_secs(5),
+    )
+    .unwrap();
+    let config = PoolConfig {
+        max_connections: 4,
+        pipeline_depth: 1,
+        idle_timeout: Duration::from_secs(60),
+        min_connections: 0,
+    };
+    let pool = Pool::new(endpoint, config, Downloads::new(4)).unwrap();
+    let read = |reader: u64, id: String| {
+        let pool = pool.clone();
+        tokio::spawn(async move {
+            let tag = Tag {
+                probe: Some(infinidysk_core::trace::Probe {
+                    trace: None,
+                    wait: None,
+                    watch: None,
+                    segment: 0,
+                    hedge: false,
+                    size: ARTICLE as u32,
+                    reader,
+                }),
+                ..cache_tag(reader, None)
+            };
+            pool.fetch(Command::Body, &id, &tag).await.is_ok()
+        })
+    };
+    let backlog: Vec<_> = ids[1..].iter().map(|id| read(1, id.clone())).collect();
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    let started = Instant::now();
+    assert!(read(2, ids[0].clone()).await.unwrap());
+    let waited = started.elapsed();
+    assert!(
+        waited < Duration::from_millis(700),
+        "the new reader waited {waited:?} behind the other's backlog"
+    );
+    for request in backlog {
+        request.abort();
+    }
+}
